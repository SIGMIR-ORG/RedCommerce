      "verifier_reason_codes": ["engagement_order_refunded"],
      "bindings": ["B-EVID", "B-STATE"],
      "consequence": {
        "reversibility": "costly-reversible",
        "description": "Ignoring the refund state preserves influence after the underlying transaction has been reversed."
